---
// Pricing.astro (初期費用0円・月額8,800円の明朗会計 ＆ 6つの内包サポート)
const guarantees = [
  { label: "ホームページ制作", value: "0円" },
  { label: "サンプル制作", value: "0円" },
  { label: "契約期間の縛り", value: "なし" },
];

const features = [
  {
    title: "ホームページ制作",
    description: "スマートフォンにも対応した、お店専用のオリジナルホームページを制作します。",
  },
  {
    title: "ドメイン・サーバー・SSL",
    description: "○○○.comなどの専用URL取得から、サーバー契約・セキュリティ設定まで一括管理します。",
  },
  {
    title: "Googleビジネスプロフィール連携",
    description: "Googleマップの店舗情報とホームページを連携。マップからのアクセスや集客力を高めます。",
  },
  {
    title: "公開後の保守管理",
    description: "技術的な管理や定期メンテナンス、万が一のトラブル対応もお任せください。",
  },
  {
    title: "文章・写真の変更",
    description: "営業時間や料金、写真など、軽微な変更や差し替えにも柔軟に対応します。",
  },
  {
    title: "相談サポート",
    description: "Webに詳しくなくても大丈夫。変更したい内容をそのままお気軽にお伝えください。",
  },
];
---

<section
  id="pricing"
  class="py-20 sm:py-24 bg-paper border-b border-ink relative overflow-hidden paper-texture"
>
  <div class="max-w-6xl mx-auto px-6 md:px-12 relative z-10">
    
    <!-- セクション見出し -->
    <div class="text-center space-y-3 mb-14 sm:mb-16">
      <span class="font-hand text-2xl text-terracotta block">Simple Pricing</span>
      <h2
        class="font-serif font-extrabold text-2xl sm:text-3xl md:text-4xl text-ink leading-tight"
      >
        ホームページに必要な費用は、これだけ。
      </h2>
      <p class="text-ink-light text-xs sm:text-sm max-w-lg mx-auto leading-relaxed pt-1">
        初期費用は0円。追加料金なしで、運営に必要なすべてが揃います。
      </p>
    </div>

    <!-- 料金メインボックス (初期費用0円 ＆ 月額8,800円) -->
    <div
      class="max-w-4xl mx-auto border-2 border-ink bg-paper p-6 sm:p-8 md:p-10 shadow-[6px_6px_0px_#1c1c1c] rounded-xl relative mb-16 pricing-card"
      id="pricing-main-card"
    >
      <!-- タグラベル -->
      <span
        class="absolute top-[-14px] left-6 font-serif font-bold text-xs tracking-wider px-3.5 py-1 border-2 border-ink bg-accent text-ink shadow-[2px_2px_0px_#1c1c1c] rounded-xs"
      >
        料金プラン
      </span>

      <!-- 料金の2分割表示 (中央寄せ) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-center pt-2 pb-8 border-b-2 border-ink/10">
        <!-- 初期費用 -->
        <div class="flex flex-col items-center text-center space-y-2">
          <span class="text-xs sm:text-sm font-serif font-bold text-ink-light tracking-wide">初期費用・制作費</span>
          <div class="flex items-baseline justify-center gap-1">
            <span class="font-serif font-extrabold text-5xl sm:text-6xl text-terracotta leading-none">0</span>
            <span class="font-serif font-bold text-2xl text-terracotta">円</span>
          </div>
        </div>

        <!-- 月額費用 -->
        <div class="flex flex-col items-center text-center space-y-2 border-t md:border-t-0 md:border-l border-ink/10 pt-6 md:pt-0 md:pl-6">
          <span class="text-xs sm:text-sm font-serif font-bold text-ink-light tracking-wide">月額利用料金</span>
          <div class="flex items-baseline justify-center gap-1">
            <span class="font-serif font-extrabold text-5xl sm:text-6xl text-ink leading-none">8,800</span>
            <span class="font-serif font-bold text-xl text-ink">円</span>
            <span class="font-serif font-bold text-xs text-ink-light ml-1">（税込）</span>
          </div>
        </div>
      </div>

      <!-- 3つの安心保証 (縛りなし・0円リスト) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 pt-6">
        {guarantees.map((item) => (
          <div class="p-3.5 bg-[#F9F7F1] border border-ink/20 rounded-lg text-center shadow-[2px_2px_0px_rgba(28,28,28,0.08)]">
            <div class="text-xs font-serif text-ink-light mb-1">{item.label}</div>
            <div class="text-base sm:text-lg font-serif font-extrabold text-terracotta">{item.value}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- 内包サポートセクション -->
    <div class="max-w-5xl mx-auto pt-4" id="pricing-features-container">
      <div class="text-center space-y-2 mb-10 sm:mb-12">
        <h3 class="font-serif font-extrabold text-xl sm:text-2xl md:text-3xl text-ink">
          ホームページに必要なもの、全部まとめてお任せください。
        </h3>
        <p class="text-xs sm:text-sm text-ink-light">
          月額8,800円の中に、以下のサポートがすべて含まれています。
        </p>
      </div>

      <!-- 6つのカードグリッド -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {features.map((item, index) => (
          <div class="p-5 sm:p-6 border-2 border-ink bg-paper rounded-lg shadow-[4px_4px_0px_#1c1c1c] flex flex-col justify-between hover:translate-y-[-2px] transition-transform duration-200 feature-card relative">
            <div class="space-y-3">
              <div class="flex items-center gap-2 border-b border-ink/10 pb-2.5">
                <span class="w-6 h-6 rounded-full bg-accent border border-ink text-[11px] font-bold text-ink flex items-center justify-center shrink-0">
                  {index + 1}
                </span>
                <h4 class="font-serif font-extrabold text-base sm:text-lg text-ink">
                  {item.title}
                </h4>
              </div>
              <p class="font-serif text-xs sm:text-sm text-ink/80 leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- 安さの理由（小さなお店に必要な機能に特化） -->
      <div class="mt-12 sm:mt-14 max-w-2xl mx-auto p-5 sm:p-6 border-2 border-dashed border-ink/30 bg-[#F9F7F1] rounded-lg text-center">
        <span class="inline-block px-3 py-0.5 bg-accent/40 border border-ink text-xs font-serif font-bold text-ink rounded-xs mb-2">
          安さの理由
        </span>
        <h4 class="font-serif font-extrabold text-base sm:text-lg text-ink mb-1.5">
          「小さなお店に必要な機能」だけに特化しているから。
        </h4>
        <p class="font-serif text-xs sm:text-sm text-ink/80 leading-relaxed max-w-lg mx-auto">
          大企業のような複雑なシステムや不要なページは作らず、個人店に必要な情報とサポートだけに絞り込んで最適化しているため、高品質なままこの価格でご提供できています。
        </p>
      </div>

      <!-- CTAボタン -->
      <div class="mt-8 text-center">
        <a
          href="#contact"
          class="inline-block bg-terracotta text-paper font-serif font-bold text-sm sm:text-base tracking-wider px-8 py-4 hover:bg-ink hover:text-paper transition-all duration-300 border-2 border-ink shadow-[4px_4px_0px_#1c1c1c] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
        >
          ▶ まずは無料でサンプルサイトを依頼する
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  // GSAPによるスクロールフェードイン
  const pricingSection = document.getElementById("pricing");

  if (pricingSection) {
    const observer = new IntersectionObserver(
      async (entries) => {
        const entry = entries[0];
        if (entry.isIntersecting) {
          observer.unobserve(pricingSection);

          try {
            const { default: gsap } = await import("gsap");

            if (
              !window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ) {
              gsap.from("#pricing-main-card", {
                opacity: 0,
                y: 40,
                duration: 0.8,
                ease: "power3.out",
              });

              gsap.from(".feature-card", {
                opacity: 0,
                y: 30,
                duration: 0.6,
                stagger: 0.12,
                delay: 0.3,
                ease: "power2.out",
              });
            }
          } catch (error) {
            console.error("Failed to load GSAP in Pricing section:", error);
          }
        }
      },
      { rootMargin: "100px" },
    );

    observer.observe(pricingSection);
  }
</script>
