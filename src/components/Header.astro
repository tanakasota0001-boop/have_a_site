---
import siteData from '../data/site-data.json';
import logoImage from '../assets/logo.png';
---

<header id="site-header" class="fixed top-0 left-0 w-full z-40 transition-all duration-300 py-6">
  <!-- ヘッダー背景用デコレーション (スクロール時にbackdrop-filter等が適用される) -->
  <div id="header-bg" class="absolute inset-0 z-[-1] transition-all duration-300 border-b border-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between relative z-10">
    <!-- ロゴ (HaveASite.) -->
    <a href="#" class="group flex items-center focus:outline-none" aria-label="HaveASite. ホーム">
      <img 
        src={logoImage.src} 
        alt="HaveASite." 
        width="150"
        height="27"
        class="h-8 md:h-10 w-auto object-contain" 
        loading="lazy"
        decoding="async"
      />
    </a>

    <!-- デスクトップ ナビゲーション -->
    <nav class="hidden lg:flex items-center space-x-8" aria-label="デスクトップナビゲーション">
      <ul class="flex items-center space-x-6">
        {siteData.navigation.map((item) => (
          <li>
            <a 
              href={item.url} 
              class="font-serif font-bold text-sm text-ink hover:text-terracotta transition-colors duration-200 py-2 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:height-[1px] after:bg-terracotta hover:after:w-full after:transition-all after:duration-300"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a 
        href="#contact" 
        class="bg-terracotta text-paper font-serif font-bold text-xs tracking-widest px-5 py-3 hover:bg-ink hover:text-paper transition-colors duration-300 border border-handwritten shadow-[2px_2px_0px_#1c1c1c] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
      >
        無料サンプルを相談する
      </a>
    </nav>

    <!-- モバイルメニュー開閉ボタン -->
    <button 
      id="mobile-menu-toggle" 
      class="lg:hidden flex flex-col justify-center items-center w-11 h-11 border-2 border-ink bg-paper rounded focus:outline-none z-50"
      aria-label="メニューを開閉する"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="w-6 h-[2px] bg-ink transition-transform duration-300 my-[3px]" id="bar-1"></span>
      <span class="w-6 h-[2px] bg-ink transition-opacity duration-300 my-[3px]" id="bar-2"></span>
      <span class="w-6 h-[2px] bg-ink transition-transform duration-300 my-[3px]" id="bar-3"></span>
    </button>
  </div>

  <!-- モバイルメニュー背景オーバーレイ -->
  <div 
    id="mobile-menu-overlay" 
    class="fixed inset-0 bg-ink/40 backdrop-blur-sm z-30 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

    <!-- モバイル ナビゲーション ドロワー -->
  <nav 
    id="mobile-nav" 
    class="fixed inset-y-0 right-0 w-full max-w-sm bg-paper border-l-2 border-ink z-50 transform translate-x-full transition-transform duration-300 ease-editorial shadow-2xl flex flex-col justify-between pt-6 pb-8 px-6 sm:px-8"
    aria-label="モバイルナビゲーション"
    aria-hidden="true"
  >
    <!-- ドロワー上部：メニュー見出しと閉じるボタン -->
    <div class="flex items-center justify-between pb-4 border-b border-ink/10">
      <span class="font-serif font-bold text-lg text-terracotta tracking-wider">MENU</span>
      <button
        id="mobile-nav-close"
        class="flex items-center justify-center w-11 h-11 border-2 border-ink bg-paper rounded focus:outline-none shadow-[2px_2px_0px_#1c1c1c] hover:bg-accent active:translate-x-[1px] active:translate-y-[1px] transition-all cursor-pointer"
        aria-label="メニューを閉じる"
      >
        <span class="text-xl font-bold leading-none select-none">✕</span>
      </button>
    </div>

    <ul class="flex flex-col space-y-5 my-auto py-6">
      {siteData.navigation.map((item, index) => (
        <li class="mobile-nav-item" style={`transition-delay: ${100 + index * 45}ms;`}>
          <a 
            href={item.url} 
            class="mobile-link font-serif font-bold text-2xl text-ink hover:text-terracotta transition-colors duration-200 flex items-center gap-3 py-1 group"
          >
            <span class="text-accent font-bold font-mono text-xl select-none transition-transform group-hover:translate-x-1">&gt;</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    
    <div class="mt-auto pt-6 border-t border-ink/20 mobile-nav-item" style="transition-delay: 350ms;">
      <p class="font-serif text-xs text-ink-light mb-3">初期費用0円・まずはお試しから</p>
      <a 
        href="#contact" 
        class="mobile-link w-full block text-center bg-terracotta text-paper font-serif font-bold text-sm tracking-widest py-3.5 border border-handwritten shadow-[3px_3px_0px_#1c1c1c] active:translate-x-[1px] active:translate-y-[1px] transition-all"
      >
        無料サンプルを相談する
      </a>
    </div>
  </nav>
</header>

<style>
  /* ドロワー自体の滑らかなスライドアニメーション (iOS風イージング) */
  #mobile-nav {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* ドロワー内リンクのスタッガー（時間差）フェード＆スライドイン */
  .mobile-nav-item {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #mobile-nav.menu-open .mobile-nav-item {
    opacity: 1;
    transform: translateX(0);
  }

  /* 閉じるボタンのホバー回転演出 */
  #mobile-nav-close span {
    transition: transform 0.25s ease;
    display: inline-block;
  }
  #mobile-nav-close:hover span {
    transform: rotate(90deg);
  }
</style>

<script>
  // スクロール時のヘッダー背景色・パディング変更
  const header = document.getElementById('site-header');
  const headerBg = document.getElementById('header-bg');
  window.addEventListener('scroll', () => {
    if (header && headerBg) {
      if (window.scrollY > 50) {
        header.classList.add('py-4');
        header.classList.remove('py-6');
        headerBg.classList.add('bg-paper/95', 'backdrop-blur-md', 'border-ink/10');
        headerBg.classList.remove('border-transparent');
      } else {
        header.classList.remove('py-4');
        header.classList.add('py-6');
        headerBg.classList.remove('bg-paper/95', 'backdrop-blur-md', 'border-ink/10');
        headerBg.classList.add('border-transparent');
      }
    }
  });

  // モバイルメニューのトグル
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-nav-close');
  const mobileNav = document.getElementById('mobile-nav');
  const overlay = document.getElementById('mobile-menu-overlay');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (mobileNav && overlay) {
      if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', String(isOpen));
      }
      mobileNav.setAttribute('aria-hidden', String(!isOpen));
      
      if (isOpen) {
        mobileNav.classList.remove('translate-x-full');
        mobileNav.classList.add('menu-open');
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100');
        if (bar1 && bar2 && bar3) {
          bar1.classList.add('rotate-45', 'translate-y-[8px]');
          bar2.classList.add('opacity-0');
          bar3.classList.add('-rotate-45', '-translate-y-[8px]');
        }
        document.body.style.overflow = 'hidden';
        
        // Lenisスクロールを停止
        // @ts-ignore
        if (window.lenisInstance) {
          // @ts-ignore
          window.lenisInstance.stop();
        }
      } else {
        mobileNav.classList.remove('menu-open');
        mobileNav.classList.add('translate-x-full');
        overlay.classList.remove('opacity-100');
        overlay.classList.add('opacity-0', 'pointer-events-none');
        if (bar1 && bar2 && bar3) {
          bar1.classList.remove('rotate-45', 'translate-y-[8px]');
          bar2.classList.remove('opacity-0');
          bar3.classList.remove('-rotate-45', '-translate-y-[8px]');
        }
        document.body.style.overflow = '';
        
        // Lenisスクロールを再開
        // @ts-ignore
        if (window.lenisInstance) {
          // @ts-ignore
          window.lenisInstance.start();
        }
      }
    }
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', toggleMenu);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', toggleMenu);
  }

  // オーバーレイクリック時に閉じる
  if (overlay) {
    overlay.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  }

  // リンククリック時に閉じる
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });
</script>
