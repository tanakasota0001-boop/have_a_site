---
// Hero.astro (アクリルアート背景レイヤー＋ブラウザフレームFV)
import bgImage from '../assets/acrylic_art_bg.png';
---

<section
  id="hero"
  class="relative overflow-hidden paper-texture min-h-[100dvh] flex flex-col justify-center items-center pt-14 sm:pt-16 pb-2 sm:pb-3 border-b border-ink"
>
  <!-- アクリル画風抽象アートの背景レイヤー (元の模様) -->
  <div
    class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden"
  >
    <div
      class="w-full h-full absolute inset-0 bg-cover bg-center bg-no-repeat opacity-[0.48] animate-fluid-bg"
      style={`background-image: url('${bgImage.src}');`}
    >
    </div>
  </div>

  <!-- 背景を程よく透かす透過紙色オーバーレイ -->
  <div class="absolute inset-0 bg-paper/45 pointer-events-none z-[1]"></div>

  <div class="max-w-[410px] sm:max-w-4xl lg:max-w-5xl mx-auto px-2.5 sm:px-6 relative z-10 w-full my-auto">
    <!-- 背面の立体レイヤー（エディトリアルなオフセットシャドウ演出） -->
    <div class="relative w-full">
      <!-- 後ろにずらして重ねたアクセント枠（サブカラー：マスタードイエロー） -->
      <div
        class="absolute inset-0 bg-[#E8D49E] translate-x-1.5 translate-y-1.5 sm:translate-x-2.5 sm:translate-y-2.5 rounded-xl border-2 border-ink -z-10"
      >
      </div>

      <!-- メインブラウザウィンドウ本体 -->
      <div
        class="relative w-full border-2 border-ink rounded-xl shadow-[3px_3px_0px_#1c1c1c] sm:shadow-[4px_4px_0px_#1c1c1c] overflow-hidden bg-paper"
        id="hero-browser-window"
      >
        <!-- ブラウザヘッダーバー (3連ドット) -->
        <div
          class="h-8 sm:h-9 border-b-2 border-ink bg-[#EDE6D8] px-3.5 sm:px-4 flex items-center select-none"
        >
          <!-- 3連カラードット (レトロMac風・黒枠付き) -->
          <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <div
              class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#FF5F56] border border-ink/60 shadow-[1px_1px_0px_#1c1c1c]"
            >
            </div>
            <div
              class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#FFBD2E] border border-ink/60 shadow-[1px_1px_0px_#1c1c1c]"
            >
            </div>
            <div
              class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#27C93F] border border-ink/60 shadow-[1px_1px_0px_#1c1c1c]"
            >
            </div>
          </div>
        </div>

        <!-- ブラウザ内部：Webサイトコンテンツ領域 -->
        <div
          class="px-4 py-5 sm:px-8 sm:py-8 md:px-12 md:py-9 lg:px-14 lg:py-10 flex flex-col items-center text-center space-y-3.5 sm:space-y-5 md:space-y-6 bg-paper paper-texture"
        >
          <!-- 1. タグラベル (サブカラー：マスタードイエローの付箋バッジ) -->
          <div
            class="inline-block px-3 py-1 sm:px-3.5 sm:py-1.5 border-2 border-ink text-[11px] md:text-xs font-bold tracking-widest uppercase bg-accent text-ink shadow-[2px_2px_0px_#1c1c1c] rotate-[-1.5deg] select-none"
          >
            個人店・小規模事業者向け
          </div>

          <!-- メインコピー -->
          <h1
            class="font-serif font-extrabold text-ink leading-[1.25] md:leading-[1.2] flex flex-col items-center drop-shadow-[0_2px_12px_rgba(253,251,247,0.98)]"
          >
            <!-- SEO・アクセシビリティ用セマンティックテキスト -->
            <span class="sr-only">HaveASite（ハブアサイト）｜初期費用0円・月額制サブスク型ホームページ制作・Webサイト制作</span>
            <span
              class="block text-base sm:text-xl md:text-2xl lg:text-3xl font-normal text-ink/90 mb-0.5 sm:mb-1"
            >
              あなたのお店の
            </span>

            <span
              class="relative inline-block px-4 sm:px-6 py-1 sm:py-1.5 my-0.5 sm:my-1 text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-terracotta rotate-[-1.5deg] origin-center scale-[1.02] transition-transform duration-300 hover:rotate-0"
            >
              ホームページ
              <svg
                class="absolute left-[-2%] top-[-5%] w-[104%] h-[110%] text-accent pointer-events-none z-[-1] hand-draw-svg drop-shadow-xs"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                id="hero-circle-svg"
              >
                <path
                  d="M10,50 C10,20 90,15 90,50 C90,80 15,85 10,55 C8,45 25,35 60,35"
                  stroke="currentColor"
                  stroke-width="3"
                  fill="none"
                  stroke-linecap="round"></path>
              </svg>
            </span>

            <!-- 3行目: ０円で作りませんか？ (「0円」を特大サイズ＋マーカー風下地で強力に強調) -->
            <span
              class="block text-xl sm:text-2xl md:text-3xl lg:text-4xl mt-1 sm:mt-1.5 leading-tight font-extrabold flex items-baseline justify-center flex-wrap gap-x-1"
            >
              <span class="relative inline-flex items-baseline mx-0.5 sm:mx-1">
                <span
                  class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif font-extrabold text-terracotta leading-none tracking-tight drop-shadow-sm"
                  >0</span
                >
                <span
                  class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-terracotta ml-0.5"
                  >円</span
                >
                <!-- 手書き風マーカーハイライト下地 (サブカラー：マスタードイエロー) -->
                <span
                  class="absolute bottom-1 sm:bottom-1.5 left-[-4px] sm:left-[-6px] right-[-4px] sm:right-[-6px] h-2.5 sm:h-4 bg-accent/50 -z-10 rounded-sm rotate-[-1deg]"
                ></span>
              </span>
              <span class="text-ink">で作りませんか？</span>
            </span>
          </h1>

          <!-- 3. サブコピー (両脇にマスタードイエローのアクセントライン) -->
          <div class="flex items-center justify-center space-x-2 sm:space-x-3 select-none">
            <div class="hidden sm:block w-8 h-[2px] bg-accent"></div>
            <p
              class="font-serif font-bold text-xs sm:text-sm md:text-base text-ink/90 tracking-wider"
            >
              実物を見てから決める、<span class="text-terracotta">サブスク型ホームページ制作</span>
            </p>
            <div class="hidden sm:block w-8 h-[2px] bg-accent"></div>
          </div>

          <!-- 4. メリット・料金チェックリスト (マスタードイエローのチェックバッジ) -->
          <div
            class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-3.5 w-full max-w-2xl sm:max-w-3xl pt-0.5 sm:pt-1"
          >
            <div
              class="flex items-center justify-center gap-2 sm:gap-2.5 bg-paper border border-ink/20 px-3 py-2 sm:py-2.5 shadow-[1.5px_1.5px_0px_rgba(28,28,28,0.12)] sm:shadow-[2px_2px_0px_rgba(28,28,28,0.12)] hover:translate-y-[-1px] transition-transform"
            >
              <span
                class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-accent border border-ink flex items-center justify-center font-bold text-ink text-[10px] sm:text-xs shrink-0 shadow-[1px_1px_0px_#1c1c1c]"
                >✓</span
              >
              <span
                class="font-serif font-bold text-xs sm:text-sm text-ink whitespace-nowrap"
                >初期費用・制作費 <span
                  class="text-terracotta font-extrabold">0円</span></span
            >
            </div>
            <div
              class="flex items-center justify-center gap-2 sm:gap-2.5 bg-paper border border-ink/20 px-3 py-2 sm:py-2.5 shadow-[1.5px_1.5px_0px_rgba(28,28,28,0.12)] sm:shadow-[2px_2px_0px_rgba(28,28,28,0.12)] hover:translate-y-[-1px] transition-transform"
            >
              <span
                class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-accent border border-ink flex items-center justify-center font-bold text-ink text-[10px] sm:text-xs shrink-0 shadow-[1px_1px_0px_#1c1c1c]"
                >✓</span
              >
              <span
                class="font-serif font-bold text-xs sm:text-sm text-ink whitespace-nowrap"
                >月額 <span class="text-terracotta font-extrabold"
                  >8,800円</span><span class="text-[9px] sm:text-[10px] text-ink-light">（税込）</span></span
              >
            </div>
            <div
              class="flex items-center justify-center gap-2 sm:gap-2.5 bg-paper border border-ink/20 px-3 py-2 sm:py-2.5 shadow-[1.5px_1.5px_0px_rgba(28,28,28,0.12)] sm:shadow-[2px_2px_0px_rgba(28,28,28,0.12)] hover:translate-y-[-1px] transition-transform"
            >
              <span
                class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-accent border border-ink flex items-center justify-center font-bold text-ink text-[10px] sm:text-xs shrink-0 shadow-[1px_1px_0px_#1c1c1c]"
                >✓</span
              >
              <span
                class="font-serif font-bold text-xs sm:text-sm text-ink whitespace-nowrap"
                >最低利用期間なし</span
              >
            </div>
          </div>

          <!-- CTAエリア -->
          <div class="pt-0.5 sm:pt-1">
            <a
              href="#contact"
              class="group inline-flex items-center justify-center text-center bg-terracotta text-paper font-serif font-bold text-sm sm:text-base tracking-wider sm:tracking-widest px-8 sm:px-12 py-3 sm:py-3.5 border-2 border-ink shadow-[3px_3px_0px_#1c1c1c] sm:shadow-[4px_4px_0px_#1c1c1c] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-200"
            >
              無料サンプルを作ってみる
              <span
                class="inline-block transition-transform group-hover:translate-x-1 duration-200 ml-1.5 sm:ml-2"
                >→</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* アクリル背景パターンの微細な平行移動アニメーション */
  @keyframes fluidPan {
    0% {
      transform: translate(0px, 0px) rotate(0deg);
    }
    50% {
      transform: translate(8px, -4px) rotate(0.3deg);
    }
    100% {
      transform: translate(0px, 0px) rotate(0deg);
    }
  }

  .animate-fluid-bg {
    animation: fluidPan 22s infinite ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fluid-bg {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // IntersectionObserver を使用して手書き丸囲みアニメーションを発火
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  const circleSvg = document.getElementById("hero-circle-svg");
  if (circleSvg) {
    observer.observe(circleSvg);
  }
</script>
