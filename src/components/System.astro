---
// System.astro (一般的な制作とHaveASiteの対比フローをシンプル＆コンパクトに魅せる)
---

<section id="system" class="py-14 sm:py-18 border-t border-b border-ink bg-[#E2D8C3] relative overflow-hidden paper-texture">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 relative z-10">
    
    <!-- セクション見出し (中央揃え・コンパクト) -->
    <div class="text-center space-y-2 mb-8 sm:mb-10">
      <span class="font-hand text-xl text-terracotta block">Risk-Free Method</span>
      <h2 class="font-serif font-extrabold text-xl sm:text-2xl md:text-3xl text-ink leading-tight">
        契約する前に、あなたのお店のホームページを作ります。
      </h2>
    </div>

    <!-- 視覚的対比フロー (シンプル＆コンパクトな横並びリスト) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 max-w-3xl mx-auto items-stretch" id="system-comparison-container">
      
      <!-- 左：一般的なホームページ制作 -->
      <div class="system-compare-card p-4 sm:p-5 border border-ink/30 bg-paper/50 rounded-lg flex flex-col justify-between">
        <div>
          <!-- カード見出し -->
          <div class="text-center pb-2.5 border-b border-ink/15 mb-3">
            <span class="font-serif font-bold text-xs sm:text-sm text-ink/70">
              一般的なホームページ制作
            </span>
          </div>

          <!-- コンパクトなステップ一覧 -->
          <div class="space-y-1.5 text-xs sm:text-sm">
            <div class="flex items-center gap-2.5 p-2 bg-white/60 rounded border border-ink/10 text-ink/70">
              <span class="w-4 h-4 rounded-full bg-ink/10 text-[10px] flex items-center justify-center font-bold shrink-0">1</span>
              <span>相談</span>
            </div>
            
            <div class="text-center text-ink/25 text-[10px] leading-none py-0.5">↓</div>
            
            <div class="flex items-center gap-2.5 p-2 bg-white/60 rounded border border-ink/10 text-ink/70">
              <span class="w-4 h-4 rounded-full bg-ink/10 text-[10px] flex items-center justify-center font-bold shrink-0">2</span>
              <span>見積り</span>
            </div>
            
            <div class="text-center text-ink/25 text-[10px] leading-none py-0.5">↓</div>
            
            <div class="flex items-center justify-between p-2 bg-[#FEE2E2]/80 rounded border border-[#DC2626]/30 text-[#991B1B] font-bold">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-[#DC2626]/20 text-[10px] flex items-center justify-center font-bold shrink-0">3</span>
                <span>契約・支払い</span>
              </div>
              <span class="text-[10px] font-normal text-[#991B1B]/80">見る前に先払い ⚠️</span>
            </div>
            
            <div class="text-center text-ink/25 text-[10px] leading-none py-0.5">↓</div>
            
            <div class="flex items-center gap-2.5 p-2 bg-white/60 rounded border border-ink/10 text-ink/70">
              <span class="w-4 h-4 rounded-full bg-ink/10 text-[10px] flex items-center justify-center font-bold shrink-0">4</span>
              <span>制作</span>
            </div>
            
            <div class="text-center text-ink/25 text-[10px] leading-none py-0.5">↓</div>
            
            <div class="flex items-center justify-between p-2 bg-white/60 rounded border border-ink/10 text-ink/70">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-ink/10 text-[10px] flex items-center justify-center font-bold shrink-0">5</span>
                <span>初めて完成形を見る</span>
              </div>
              <span class="text-[10px] text-ink/50">イメージ違いの不安</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 右：HaveASite (ハブアサイト) -->
      <div class="system-compare-card p-4 sm:p-5 border-2 border-ink bg-paper rounded-lg relative flex flex-col justify-between shadow-[4px_4px_0px_#1c1c1c]">
        <div>
          <!-- カード見出し -->
          <div class="text-center pb-2.5 border-b-2 border-ink mb-3">
            <span class="font-serif font-extrabold text-sm sm:text-base text-ink flex items-center justify-center gap-1">
              HaveASite
            </span>
          </div>

          <!-- コンパクトなステップ一覧 -->
          <div class="space-y-1.5 text-xs sm:text-sm">
            <div class="flex items-center justify-between p-2 bg-white rounded border border-ink/20 font-serif font-bold text-ink">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-ink text-paper text-[10px] flex items-center justify-center font-bold shrink-0">1</span>
                <span>無料相談</span>
              </div>
              <span class="text-[10px] font-normal text-ink-light">LINEで送るだけ</span>
            </div>
            
            <div class="text-center text-terracotta text-[10px] leading-none py-0.5 font-bold">↓</div>
            
            <div class="flex items-center justify-between p-2 bg-[#FEF08A] rounded border-2 border-ink font-serif font-extrabold text-ink shadow-[1px_1px_0px_#1c1c1c]">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-terracotta text-white text-[10px] flex items-center justify-center font-bold shrink-0">2</span>
                <span>サンプルサイト制作</span>
              </div>
              <span class="text-[10px] bg-terracotta text-white px-1.5 py-0.5 rounded font-bold">無料 0円</span>
            </div>
            
            <div class="text-center text-terracotta text-[10px] leading-none py-0.5 font-bold">↓</div>
            
            <div class="flex items-center justify-between p-2 bg-white rounded border border-ink/20 font-serif font-bold text-ink">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-ink text-paper text-[10px] flex items-center justify-center font-bold shrink-0">3</span>
                <span>実際のサイトを見る</span>
              </div>
              <span class="text-[10px] font-normal text-ink-light">スマホで体験</span>
            </div>
            
            <div class="text-center text-terracotta text-[10px] leading-none py-0.5 font-bold">↓</div>
            
            <div class="flex items-center justify-between p-2 bg-[#BAE6FD] rounded border border-ink/30 font-serif font-bold text-ink">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-ink text-paper text-[10px] flex items-center justify-center font-bold shrink-0">4</span>
                <span>「これなら欲しい」と納得</span>
              </div>
              <span class="text-[10px] font-normal text-ink/70">気に入った場合のみ</span>
            </div>
            
            <div class="text-center text-terracotta text-[10px] leading-none py-0.5 font-bold">↓</div>
            
            <div class="flex items-center justify-between p-2 bg-accent rounded border-2 border-ink font-serif font-extrabold text-ink shadow-[1px_1px_0px_#1c1c1c]">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-ink text-paper text-[10px] flex items-center justify-center font-bold shrink-0">5</span>
                <span>ここで初めて契約</span>
              </div>
              <span class="text-[10px] text-terracotta font-bold">月額8,800円</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- 下部：シンプル＆コンパクトな安心バッジ -->
    <div class="mt-8 sm:mt-9 max-w-xl mx-auto text-center" id="system-guarantee-box">
      <div class="inline-block bg-paper px-6 py-3 border-2 border-ink shadow-[4px_4px_0px_#1c1c1c] rounded-lg">
        <span class="font-serif font-extrabold text-sm sm:text-base md:text-lg text-ink">
          気に入らなければ、<span class="text-terracotta underline decoration-accent decoration-2 underline-offset-2">契約しなくてOK</span>。0円です。
        </span>
      </div>
    </div>

  </div>
</section>

<script>
  // GSAPによるスクロール連動アニメーション
  const compContainer = document.getElementById('system-comparison-container');

  if (compContainer) {
    const observer = new IntersectionObserver(async (entries) => {
      const entry = entries[0];
      if (entry.isIntersecting) {
        observer.unobserve(compContainer);

        try {
          const { default: gsap } = await import('gsap');
          
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            gsap.from('.system-compare-card', {
              opacity: 0,
              y: 25,
              scale: 0.98,
              duration: 0.6,
              stagger: 0.2,
              ease: 'power2.out',
              onStart: function() {
                gsap.set('.system-compare-card', { transition: 'none' });
              },
              onComplete: function() {
                gsap.set('.system-compare-card', { clearProps: "transition,opacity,transform" });
              }
            });

            const guaranteeBox = document.getElementById('system-guarantee-box');
            if (guaranteeBox) {
              gsap.from(guaranteeBox, {
                opacity: 0,
                y: 15,
                delay: 0.4,
                duration: 0.5,
                ease: 'back.out(1.4)'
              });
            }
          }
        } catch (error) {
          console.error('Failed to load GSAP in System section:', error);
        }
      }
    }, { rootMargin: '80px' });

    observer.observe(compContainer);
  }
</script>
