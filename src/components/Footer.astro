---
import siteData from "../data/site-data.json";
import logoImage from "../assets/logo.png";
---

<footer class="bg-ink text-paper pt-16 pb-12 border-t-2 border-ink">
  <div
    class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 mb-12"
  >
    <!-- 左：ロゴとサブタイトル -->
    <div class="space-y-2">
      <a
        href="#"
        class="inline-block group focus:outline-none"
        aria-label="HaveASite."
      >
        <img
          src={logoImage.src}
          alt="HaveASite."
          width="120"
          height="22"
          class="h-7 md:h-8 w-auto object-contain invert hue-rotate-180"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="text-xs text-paper/60 tracking-widest font-serif leading-relaxed">
        あなたのお店の魅力をカタチに。
      </p>
    </div>

    <!-- 中：ナビゲーションリンク -->
    <div class="space-y-4 md:max-w-[220px] md:mx-auto w-full">
      <p
        class="font-serif font-bold text-sm tracking-wider text-accent border-b border-paper/10 pb-2"
      >
        MENU
      </p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-paper/80 font-sans">
        {
          siteData.navigation.map((item) => (
            <li>
              <a
                href={item.url}
                class="hover:text-accent transition-colors duration-200 block py-0.5"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 右：お問い合わせ・ご相談 (控えめなテキストリンク) -->
    <div class="space-y-4 md:max-w-[280px] md:ml-auto w-full">
      <p
        class="font-serif font-bold text-sm tracking-wider text-accent border-b border-paper/10 pb-2"
      >
        CONTACT
      </p>
      <p class="text-xs text-paper/60 leading-relaxed font-sans">
        無料サンプルのご相談・お問い合わせ
      </p>
      <ul class="space-y-2 text-xs text-paper/80 font-sans">
        <li>
          <a
            href="#contact"
            class="hover:text-accent transition-colors duration-200 inline-flex items-center gap-1.5"
          >
            <span class="text-accent text-[10px]">▶</span>
            <span>Webフォームから相談する</span>
          </a>
        </li>
        <li>
          <a
            href={siteData.contact.lineUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent transition-colors duration-200 inline-flex items-center gap-1.5"
          >
            <span class="text-accent text-[10px]">▶</span>
            <span>公式LINEで相談する</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- フッターボトム -->
  <div
    class="max-w-7xl mx-auto px-6 md:px-12 pt-8 border-t border-paper/10 flex flex-row items-center justify-between gap-4 text-xs text-paper/40"
  >
    <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-0 sm:space-x-6">
      <a
        href="/privacy-policy"
        class="hover:text-accent transition-colors duration-200"
      >
        プライバシーポリシー
      </a>
      <p>&copy; 2026 HaveASite. All rights reserved.</p>
    </div>

    <!-- トップに戻るボタン (モバイル: 棒なし山型シェブロン＆右側配置 / PC: 既存の見た目・配置を完全維持) -->
    <a
      href="#"
      class="flex items-center justify-center transition-all select-none shrink-0 w-11 h-11 rounded-full bg-paper/10 border-2 border-paper/30 text-paper shadow-[2px_2px_0px_rgba(0,0,0,0.3)] active:bg-accent active:text-ink active:border-accent active:scale-95 sm:w-9 sm:h-9 sm:rounded-full sm:bg-transparent sm:border sm:border-paper/30 sm:text-paper/80 sm:hover:text-ink sm:hover:bg-accent sm:hover:border-accent sm:font-mono sm:font-bold sm:text-sm sm:shadow-[2px_2px_0px_rgba(0,0,0,0.3)] sm:active:scale-100"
      aria-label="ページトップへ戻る"
      title="ページトップへ戻る"
    >
      <!-- モバイル用：棒のない山型シェブロンアイコン (∧) -->
      <svg
        class="w-5 h-5 block sm:hidden -translate-y-[1px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 15l-6-6-6 6" />
      </svg>
      <!-- PC用：既存の「^」をそのまま表示 -->
      <span class="hidden sm:inline">^</span>
    </a>
  </div>
</footer>
