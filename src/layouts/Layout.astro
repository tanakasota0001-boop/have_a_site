---
import '../styles/global.css';
import siteData from '../data/site-data.json';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  ogImage?: string;
  canonicalUrl?: string;
}

const { 
  title = siteData.site.title, 
  description = siteData.site.description,
  schema,
  noindex = false,
  ogImage = '/og-image.png',
  canonicalUrl
} = Astro.props;

// 正規URLの算出 (Astro.site または siteData.site.url を基準)
const siteOrigin = Astro.site ? Astro.site.origin : siteData.site.url;
const canonicalHref = canonicalUrl || new URL(Astro.url.pathname, siteOrigin).href;
const ogImageHref = new URL(ogImage, siteOrigin).href;

// WebSite 構造化データ
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "HaveASite",
  "alternateName": ["HaveASite", "ハブアサイト"],
  "url": siteOrigin,
  "description": siteData.site.description,
  "inLanguage": "ja"
};

// ProfessionalService 構造化データ
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "HaveASite",
  "alternateName": "HaveASite",
  "description": description,
  "url": siteOrigin,
  "logo": `${siteOrigin}/assets/logo.png`,
  "image": ogImageHref,
  "telephone": siteData.company.phone,
  "openingHours": siteData.company.openingHours,
  "priceRange": "¥8800",
  "currenciesAccepted": "JPY",
  "paymentAccepted": "クレジットカード, 銀行振込",
  "knowsAbout": [
    "ホームページ制作",
    "サブスク型ホームページ制作",
    "Webサイト制作",
    "LP（ランディングページ）制作",
    "SEO対策",
    "Webサイト保守運用管理"
  ],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteData.company.geo.latitude,
    "longitude": siteData.company.geo.longitude
  },
  "address": {
    "@type": "PostalAddress",
    "postalCode": siteData.company.address.postalCode,
    "addressRegion": siteData.company.address.addressRegion,
    "addressLocality": siteData.company.address.addressLocality,
    "streetAddress": siteData.company.address.streetAddress,
    "addressCountry": "JP"
  },
  "areaServed": [
    {
      "@type": "AdministrativeArea",
      "name": "長野県"
    },
    {
      "@type": "Country",
      "name": "JP"
    }
  ],
  "offers": {
    "@type": "Offer",
    "price": siteData.pricing.basePrice.replace(/,/g, ''),
    "priceCurrency": "JPY",
    "description": `初期費用0円、月額${siteData.pricing.basePrice}円（税込）のサブスク型ホームページ制作・保守運用プラン`
  },
  "sameAs": [
    siteData.contact.lineUrl,
    siteData.contact.instagramUrl,
    siteData.contact.xUrl
  ]
};

// 全構造化データを配列に格納
const schemas = [websiteSchema, serviceSchema];
if (schema) {
  if (Array.isArray(schema)) {
    schemas.push(...schema);
  } else {
    schemas.push(schema);
  }
}
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- ファビコン・アプリアイコン -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FFFFFF" />
    
    <!-- SEO 基本メタタグ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <meta 
      name="robots" 
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} 
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- OGP (Open Graph Protocol) -->
    <meta property="og:type" content={Astro.url.pathname === '/' ? 'website' : 'article'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HaveASite サブスク型ホームページ制作" />
    <meta property="og:site_name" content="HaveASite" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />
    
    <!-- Google Fonts 最適化 (使用フォントのみに厳選: Shippori Mincho, Noto Sans JP, Outfit, Caveat) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Outfit:wght@400;700;900&family=Shippori+Mincho:wght@400;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Outfit:wght@400;700;900&family=Shippori+Mincho:wght@400;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Outfit:wght@400;700;900&family=Shippori+Mincho:wght@400;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- JSON-LD 構造化データ -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="bg-paper text-ink font-sans antialiased overflow-x-hidden selection:bg-terracotta/20 selection:text-terracotta">
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-accent focus:text-ink focus:px-4 focus:py-2 focus:z-50 focus:rounded focus:outline-none focus:ring-2 focus:ring-terracotta">
      メインコンテンツへ移動
    </a>

    <slot />

    <!-- Lenis & Scroll Animations Bootstrapper -->
    <script>
      // ユーザーがアニメーションを抑えたい(prefers-reduced-motion)かを検出
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const initDynamic = async () => {
          try {
            // Lenisのインポートと初期化
            const { default: Lenis } = await import('lenis');
            const lenis = new Lenis({
              duration: 1.2,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
              orientation: 'vertical',
              gestureOrientation: 'vertical',
              smoothWheel: true,
              wheelMultiplier: 1,
              touchMultiplier: 1.5,
            });

            // requestAnimationFrame で lenis のアップデートをループ
            function raf(time: number) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            // GSAP スムーススクロールとの連携用
            // @ts-ignore
            window.lenisInstance = lenis;

            // ページ内アンカーリンクの遷移をLenisでスムーズにする
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
              anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                if (!targetId) return;
                
                if (targetId === '#' || targetId === '#top') {
                  lenis.scrollTo(0, { immediate: false });
                  return;
                }
                
                const target = document.querySelector(targetId);
                if (target) {
                  lenis.scrollTo(target, {
                    offset: -80, // ヘッダー分を考慮したオフセット
                    immediate: false
                  });
                  
                  // フォーカス移動 (アクセシビリティ対応)
                  (target as HTMLElement).focus({ preventScroll: true });
                }
              });
            });
          } catch (error) {
            console.error('Failed to initialize dynamic scripts:', error);
          }
        };

        if (document.readyState === 'complete') {
          initDynamic();
        } else {
          window.addEventListener('load', initDynamic);
        }
      } else {
        // prefers-reduced-motion が有効な場合の、標準のスクロール挙動
        document.documentElement.style.scrollBehavior = 'auto';
      }
    </script>
  </body>
</html>
